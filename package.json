{
  "name": "nightward",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "wasm": "node scripts/wasm.mjs",
    "build": "npm run wasm && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:qa": "tsc --noEmit -p tsconfig.qa.json",
    "qa": "playwright test --project=webgl",
    "qa:webgpu": "playwright test --project=webgpu",
    "qa:firefox": "playwright test --project=firefox",
    "qa:all": "playwright test",
    "qa:report": "playwright show-report qa/.report",
    "gauntlet": "node scripts/run-gauntlet.mjs"
  },
  "dependencies": {
    "pixi.js": "^8.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "wasm-pack": "^0.13.0"
  }
}
